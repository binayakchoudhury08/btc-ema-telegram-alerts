//@version=5
// Alerts on TradingView's OWN data (e.g. CRYPTO:BTCUSD), on ANY timeframe (the chart's timeframe).
//
// 9 EMA vs EMA High (blue) / EMA Low (red):
//   TOUCH      - live 9 EMA touches a line (within "Touch distance") or jumps across it
//   CONFIRMED  - checked on the first tick after the candle closes: the 9 EMA crossed the line
//   CANCELLED  - it touched during the candle, but did not cross by the close
//
// Price levels (up to 3):
//   LEVEL_CROSS - price crosses the level (by more than the buffer)
//   LEVEL_BACK  - price comes back through the level; includes how long it stayed past it
//
// Alerts go out by EMAIL (no webhook, no 2FA). A Gmail script forwards them to Telegram.
indicator("9 EMA Cross -> Telegram (CRYPTO exact)", overlay = true)

grpE = "9 EMA alerts"
fastLen   = input.int(9,  "Purple 9 EMA length", group = grpE)
slowLen   = input.int(20, "EMA High / EMA Low length", group = grpE)
touchUsd  = input.float(25, "Touch distance in USD (lines this close = touching)", minval = 0, step = 5, group = grpE)
emaAlerts = input.bool(true, "Send 9 EMA touch / confirmed / cancelled alerts", group = grpE)

grpL = "Price level alerts (0 = off)"
lvl1   = input.float(0, "Level 1 price", group = grpL)
lvl2   = input.float(0, "Level 2 price", group = grpL)
lvl3   = input.float(0, "Level 3 price", group = grpL)
lvlBuf = input.float(10, "Buffer in USD (price must pass the level by this much)", minval = 0, group = grpL)

grpG = "General"
webKey    = input.string("CHANGE_ME", "Key (same as WEBHOOK_KEY on Vercel)", group = grpG)
chartBars = input.int(40, "Candles sent for the chart photo", minval = 10, maxval = 60, group = grpG)
showLines = input.bool(true, "Show the 3 lines on the chart", group = grpG)

fast = ta.ema(close, fastLen)
emaH = ta.ema(high, slowLen)
emaL = ta.ema(low, slowLen)

plot(showLines ? fast : na, "9 EMA",    color.purple, 2)
plot(showLines ? emaH : na, "EMA High", color.blue,   2)
plot(showLines ? emaL : na, "EMA Low",  color.red,    2)
plot(lvl1 > 0 ? lvl1 : na, "Level 1", color.orange, 1, plot.style_linebr)
plot(lvl2 > 0 ? lvl2 : na, "Level 2", color.orange, 1, plot.style_linebr)
plot(lvl3 > 0 ? lvl3 : na, "Level 3", color.orange, 1, plot.style_linebr)

// ---- last N candles (incl. the live one) for the chart photo ----
var aO = array.new_float()
var aH = array.new_float()
var aL = array.new_float()
var aC = array.new_float()
var aF = array.new_float()
var aB = array.new_float()
var aR = array.new_float()

push(a, v) =>
    array.push(a, v)
    if array.size(a) > chartBars
        array.shift(a)
    a

push(aO, open)
push(aH, high)
push(aL, low)
push(aC, close)
push(aF, fast)
push(aB, emaH)
push(aR, emaL)

join(a, dropLast) =>
    s = ""
    n = array.size(a) - (dropLast ? 1 : 0)
    if n > 0
        for i = 0 to n - 1
            s := s + (i == 0 ? "" : ",") + str.tostring(array.get(a, i), "#.##")
    "[" + s + "]"

num(x) => str.tostring(x, "#.##")

// k = 0: the live candle,  k = 1: the candle that just closed
payload(stage, lineName, dir, seenMs, k, extra) =>
    dl = k == 1
    "{\"key\":\"" + webKey + "\",\"stage\":\"" + stage + "\"" +
     ",\"ticker\":\"" + syminfo.ticker + "\",\"source\":\"TradingView-" + syminfo.tickerid + "\"" +
     ",\"tf\":" + str.tostring(timeframe.in_seconds(), "#") +
     ",\"t\":" + str.tostring(time[k], "#") + ",\"seen\":" + str.tostring(seenMs, "#") +
     ",\"line\":\"" + lineName + "\",\"dir\":\"" + dir + "\"" + extra +
     ",\"o\":" + num(open[k]) + ",\"h\":" + num(high[k]) + ",\"l\":" + num(low[k]) + ",\"c\":" + num(close[k]) +
     ",\"fast\":" + num(fast[k]) + ",\"blue\":" + num(emaH[k]) + ",\"red\":" + num(emaL[k]) +
     ",\"bars\":{\"o\":" + join(aO, dl) + ",\"h\":" + join(aH, dl) + ",\"l\":" + join(aL, dl) + ",\"c\":" + join(aC, dl) +
     ",\"fast\":" + join(aF, dl) + ",\"blue\":" + join(aB, dl) + ",\"red\":" + join(aR, dl) + "}}"

lvlExtra(L, crossedMs) => ",\"level\":" + num(L) + ",\"crossed\":" + str.tostring(crossedMs, "#")

sgn(a, b) => a > b ? 1 : a < b ? -1 : 0
near(a, b) => math.abs(a - b) <= touchUsd

// =============== 9 EMA: TOUCH -> CONFIRMED / CANCELLED ===============
varip bool touchB  = false
varip bool touchR  = false
varip int  touchBt = 0
varip int  touchRt = 0

// --- STAGE 2 first: on the first tick of a new candle, judge the candle that just closed ---
if barstate.isnew and barstate.isrealtime and emaAlerts
    cb = sgn(fast[1], emaH[1])
    pb = sgn(fast[2], emaH[2])
    if pb != 0 and cb != 0 and cb != pb
        alert(payload("CONFIRMED", "blue", cb > 0 ? "UPWARD" : "DOWNWARD", touchBt, 1, ""), alert.freq_all)
    else if touchB
        alert(payload("CANCELLED", "blue", pb < 0 ? "UPWARD" : "DOWNWARD", touchBt, 1, ""), alert.freq_all)
    cr = sgn(fast[1], emaL[1])
    pr = sgn(fast[2], emaL[2])
    if pr != 0 and cr != 0 and cr != pr
        alert(payload("CONFIRMED", "red", cr > 0 ? "UPWARD" : "DOWNWARD", touchRt, 1, ""), alert.freq_all)
    else if touchR
        alert(payload("CANCELLED", "red", pr < 0 ? "UPWARD" : "DOWNWARD", touchRt, 1, ""), alert.freq_all)

if barstate.isnew
    touchB  := false
    touchR  := false
    touchBt := 0
    touchRt := 0

// --- STAGE 1: live touch on the open candle (once per line per candle, only a NEW touch) ---
bPrev = sgn(fast[1], emaH[1])
bNow  = sgn(fast, emaH)
rPrev = sgn(fast[1], emaL[1])
rNow  = sgn(fast, emaL)

if barstate.isrealtime and emaAlerts
    if not touchB and bPrev != 0 and not near(fast[1], emaH[1]) and (near(fast, emaH) or bNow != bPrev)
        touchB  := true
        touchBt := timenow
        alert(payload("TOUCH", "blue", bPrev < 0 ? "UPWARD" : "DOWNWARD", timenow, 0, ""), alert.freq_all)
    if not touchR and rPrev != 0 and not near(fast[1], emaL[1]) and (near(fast, emaL) or rNow != rPrev)
        touchR  := true
        touchRt := timenow
        alert(payload("TOUCH", "red", rPrev < 0 ? "UPWARD" : "DOWNWARD", timenow, 0, ""), alert.freq_all)

// =============== PRICE LEVELS: CROSS -> BACK ===============
varip int ls1 = 0
varip int lt1 = 0
varip int ls2 = 0
varip int lt2 = 0
varip int ls3 = 0
varip int lt3 = 0

if barstate.isrealtime and lvl1 > 0
    s = close > lvl1 + lvlBuf ? 1 : close < lvl1 - lvlBuf ? -1 : 0
    if s != 0
        if ls1 == 0
            ls1 := s
        else if s != ls1
            if lt1 == 0
                alert(payload("LEVEL_CROSS", "level", s > 0 ? "UPWARD" : "DOWNWARD", timenow, 0, lvlExtra(lvl1, 0)), alert.freq_all)
                lt1 := timenow
            else
                alert(payload("LEVEL_BACK", "level", s > 0 ? "UPWARD" : "DOWNWARD", timenow, 0, lvlExtra(lvl1, lt1)), alert.freq_all)
                lt1 := 0
            ls1 := s

if barstate.isrealtime and lvl2 > 0
    s = close > lvl2 + lvlBuf ? 1 : close < lvl2 - lvlBuf ? -1 : 0
    if s != 0
        if ls2 == 0
            ls2 := s
        else if s != ls2
            if lt2 == 0
                alert(payload("LEVEL_CROSS", "level", s > 0 ? "UPWARD" : "DOWNWARD", timenow, 0, lvlExtra(lvl2, 0)), alert.freq_all)
                lt2 := timenow
            else
                alert(payload("LEVEL_BACK", "level", s > 0 ? "UPWARD" : "DOWNWARD", timenow, 0, lvlExtra(lvl2, lt2)), alert.freq_all)
                lt2 := 0
            ls2 := s

if barstate.isrealtime and lvl3 > 0
    s = close > lvl3 + lvlBuf ? 1 : close < lvl3 - lvlBuf ? -1 : 0
    if s != 0
        if ls3 == 0
            ls3 := s
        else if s != ls3
            if lt3 == 0
                alert(payload("LEVEL_CROSS", "level", s > 0 ? "UPWARD" : "DOWNWARD", timenow, 0, lvlExtra(lvl3, 0)), alert.freq_all)
                lt3 := timenow
            else
                alert(payload("LEVEL_BACK", "level", s > 0 ? "UPWARD" : "DOWNWARD", timenow, 0, lvlExtra(lvl3, lt3)), alert.freq_all)
                lt3 := 0
            ls3 := s
